# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (local development)
# If you have MongoDB installed locally:
MONGODB_URI=mongodb://localhost:27017/ddm-experiment

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# NOTE: If you don't have MongoDB installed locally,
# you'll need to create a FREE MongoDB Atlas cluster:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create free M0 cluster
# 3. Get connection string
# 4. Replace MONGODB_URI above with your Atlas connection string
